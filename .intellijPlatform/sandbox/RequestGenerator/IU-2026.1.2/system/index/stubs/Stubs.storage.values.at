                         COALESCE(
                                 s.full_name,
                                 CONCAT(c.name, ' ', c.surname, ' ', c.patronym)
                             , au.full_name
                             , iss.full_name
                             )       AS full_name,
                         COALESCE(
                                 s.pin,
                                 c.pnfl,
                                 au.pinfl,
                                 iss.pnfl
                             )       AS pnfl,
                         CASE
                             WHEN s.id IS NOT NULL THEN COALESCE(IF(s.gd IS NULL, NULL, IF(s.gd = 'Erkak', 1, 2)), IF(SUBSTRING(s.pin, 1, 1) IN ('1','3','5','7'), 1, IF(SUBSTRING(s.pin, 1, 1) IN ('2','4','6','8'), 2, NULL)))
                             WHEN c.id IS NOT NULL THEN COALESCE(c.gender_code, IF(SUBSTRING(c.pnfl, 1, 1) IN ('1','3','5','7'), 1, IF(SUBSTRING(c.pnfl, 1, 1) IN ('2','4','6','8'), 2, NULL)))
                             WHEN au.id IS NOT NULL THEN COALESCE(IF(au.gender IS NULL, NULL, IF(au.gender = 'male', 1, 2)), IF(SUBSTRING(au.pinfl, 1, 1) IN ('1','3','5','7'), 1, IF(SUBSTRING(au.pinfl, 1, 1) IN ('2','4','6','8'), 2, NULL)))
                             WHEN iss.id IS NOT NULL THEN COALESCE(IF(iss.gender IS NULL, NULL, IF(iss.gender = 'male', 1, 2)), IF(SUBSTRING(iss.pnfl, 1, 1) IN ('1','3','5','7'), 1, IF(SUBSTRING(iss.pnfl, 1, 1) IN ('2','4','6','8'), 2, NULL)))
                             ELSE NULL
                             END                               AS gender,
                         e.dep_name  AS dep_name,
                         e.position  AS position,
                         e.begin_date                          AS begin_date,
                         a.address   AS address,
                         e.exp_type  AS exp_type,
                         CASE
                             WHEN s.id IS NOT NULL THEN 'otm'
                             WHEN c.id IS NOT NULL THEN 'uzbek_coders'
                             WHEN au.id IS NOT NULL THEN 'ak_user'
                             WHEN iss.id IS NOT NULL THEN 'it_study'
                             END     AS source,
                         fs.name                               AS speciality
                  FROM experience e
                           LEFT JOIN student s ON s.id = e.student_id
                           LEFT JOIN uzbek_coders_user c ON c.id = e.coders_user_id
                           LEFT JOIN alkharazmi_user au ON au.id = e.alkharazmi_user_id
                           LEFT JOIN it_study_student iss ON iss.id = e.it_study_student_id
                           LEFT JOIN address a ON s.id = a.student_id
                           LEFT JOIN education e2 on s.id = e2.student_id
                           LEFT JOIN faculty_speciality fs on e2.speciality_id = fs.id
                  WHERE e.deleted = false
                    AND (:keyword IS NULL OR (
                              COALESCE(s.full_name, CONCAT(c.name, ' ', c.surname, ' ', c.patronym), au.full_name, iss.full_name)
                              LIKE CONCAT('%', :keyword, '%')
                          OR COALESCE(s.pin, c.pnfl, au.pinfl, iss.pnfl) LIKE CONCAT('%', :keyword, '%')
                          OR e.dep_name LIKE CONCAT('%', :keyword, '%')
                          OR e.position LIKE CONCAT('%', :keyword, '%')
                          OR a.address LIKE CONCAT('%', :keyword, '%')
                      ))
                    AND (:gender IS NULL OR (
                          CASE
                              WHEN s.id IS NOT NULL THEN COALESCE(IF(s.gd IS NULL, NULL, IF(s.gd = 'Erkak', 1, 2)), IF(SUBSTRING(s.pin, 1, 1) IN ('1','3','5','7'), 1, IF(SUBSTRING(s.pin, 1, 1) IN ('2','4','6','8'), 2, NULL)))
                              WHEN c.id IS NOT NULL THEN COALESCE(c.gender_code, IF(SUBSTRING(c.pnfl, 1, 1) IN ('1','3','5','7'), 1, IF(SUBSTRING(c.pnfl, 1, 1) IN ('2','4','6','8'), 2, NULL)))
                              WHEN au.id IS NOT NULL THEN COALESCE(IF(au.gender IS NULL, NULL, IF(au.gender = 'male', 1, 2)), IF(SUBSTRING(au.pinfl, 1, 1) IN ('1','3','5','7'), 1, IF(SUBSTRING(au.pinfl, 1, 1) IN ('2','4','6','8'), 2, NULL)))
                              WHEN iss.id IS NOT NULL THEN COALESCE(IF(iss.gender IS NULL, NULL, IF(iss.gender = 'male', 1, 2)), IF(SUBSTRING(iss.pnfl, 1, 1) IN ('1','3','5','7'), 1, IF(SUBSTRING(iss.pnfl, 1, 1) IN ('2','4','6','8'), 2, NULL)))
                              ELSE NULL
                              END = :gender
                      ))
                    AND (
                        :age_from IS NULL OR
                        TIMESTAMPDIFF(YEAR,
                            STR_TO_DATE(CONCAT(
                                CASE WHEN SUBSTRING(e.pin, 1, 1) IN ('1','2') THEN '18'
                                     WHEN SUBSTRING(e.pin, 1, 1) IN ('3','4') THEN '19'
                                     ELSE '20' END,
                                SUBSTRING(e.pin, 6, 2), '-', SUBSTRING(e.pin, 4, 2), '-', SUBSTRING(e.pin, 2, 2)
                            ), '%Y-%m-%d'), CURDATE()
                        ) BETWEEN :age_from AND :age_to
                    )
                    AND (
                          :source IS NULL OR
                          (:source = 'otm' AND e.student_id IS NOT NULL) OR
                          (:source = 'uzbek_coders' AND e.coders_user_id IS NOT NULL AND c.register_time <= FROM_UNIXTIME(1761955200000 / 1000)) OR
                          (:source = 'ak_user' AND e.alkharazmi_user_id IS NOT NULL) OR
                          (:source = 'it_study' AND EXISTS (
                                SELECT 1 FROM experience ex
                                WHERE ex.pin = e.pin
                                  AND ex.it_study_student_id IS NOT NULL
                                  AND ex.deleted = false
                            ))
                      )
                    AND (:employed_date_from IS NULL OR e.begin_date BETWEEN :employed_date_from AND :employed_date_to)
                    AND (:region IS NULL OR CASE
                        WHEN a.region LIKE '%–¢–û–®–ö–ï–ù–¢ –®–ê“≤–†–ò%' OR a.region LIKE '%Toshkent shahri%' THEN 'Toshkent shahri'
                        WHEN a.region LIKE '%–¢–û–®–ö–ï–ù–¢%' OR a.region LIKE '%Toshkent viloyati%' THEN 'Toshkent viloyati'
                        WHEN a.region LIKE '%–ê–ù–î–ò–ñ–û–ù%' OR a.region LIKE '%Andijon%' THEN 'Andijon'
                        WHEN a.region LIKE '%–ë–£–•–û–†–û%' OR a.region LIKE '%Buxoro%' THEN 'Buxoro'
                        WHEN a.region LIKE '%–§–ê–†“í–û–ù–ê%' OR a.region LIKE '%Farg%' THEN 'Farg''ona'
                        WHEN a.region LIKE '%–ñ–ò–ó–ó–ê–•%' OR a.region LIKE '%Jizzax%' THEN 'Jizzax'
                        WHEN a.region LIKE '%–ù–ê–ú–ê–ù–ì–ê–ù%' OR a.region LIKE '%Namangan%' THEN 'Namangan'
                        WHEN a.region LIKE '%–ù–ê–í–û–ò–ô%' OR a.region LIKE '%Navoiy%' THEN 'Navoiy'
                        WHEN a.region LIKE '%“ö–ê–®“ö–ê–î–ê–†–Å%' OR a.region LIKE '%Qashqadaryo%' THEN 'Qashqadaryo'
                        WHEN a.region LIKE '%“ö–û–†–ê“ö–ê–õ–ü–û“í%' OR a.region LIKE '%Qoraqalpog%' THEN 'Qoraqalpog''iston'
                        WHEN a.region LIKE '%–°–ê–ú–ê–†“ö–ê–ù–î%' OR a.region LIKE '%Samarqand%' THEN 'Samarqand'
                        WHEN a.region LIKE '%–°–ò–†–î–ê–†–Å%' OR a.region LIKE '%Sirdaryo%' THEN 'Sirdaryo'
                        WHEN a.region LIKE '%–°–£–†–•–û–ù–î–ê–†–Å%' OR a.region LIKE '%Surxondaryo%' THEN 'Surxondaryo'
                        WHEN a.region LIKE '%–•–û–†–ê–ó–ú%' OR a.region LIKE '%Xorazm%' THEN 'Xorazm'
                        ELSE a.region
                    END = :region)
                    AND (:exp_type IS NULL OR :exp_type = e.exp_type)
                    AND (:speciality IS NULL OR fs.name LIKE CONCAT('%', :speciality, '%'))
                  UNION ALL
                  SELECT se.id                                      AS id,
                         CONCAT(se.firstName, ' ', se.lastName, ' ', se.middleName) ,
                         se.pinfl ,
                         se.gender_code,
                         NULL,
                         se.activityName ,
                         se.registrationDate,
                         se.villageName ,
                         'self_employed' ,
                         'self_employed'  AS source,
                         NULL                                       AS speciality
                  FROM self_employeds se
                           LEFT JOIN address a  ON se.source_type = 'student'  AND se.source_id = a.student_id
                           LEFT JOIN address a1 ON se.source_type = 'coder'    AND se.source_id = a1.coders_user_id
                           LEFT JOIN address a2 ON se.source_type = 'ak_user'  AND se.source_id = a2.alkharazmi_user_id
                           LEFT JOIN address a3 ON se.source_type = 'it_study' AND se.source_id = a3.it_city_user_id
                  WHERE 1 = 1
                    AND (:keyword IS NULL OR (
                              CONCAT(se.firstName, ' ', se.lastName, ' ', se.middleName)
                              LIKE CONCAT('%', :keyword, '%')
                          OR se.activityName LIKE CONCAT('%', :keyword, '%')
                          OR se.pinfl LIKE CONCAT('%', :keyword, '%')
                          OR se.villageName LIKE CONCAT('%', :keyword, '%')
                      ))
                    AND (:gender IS NULL OR COALESCE(se.gender_code, IF(SUBSTRING(se.pinfl, 1, 1) IN ('1','3','5','7'), 1, IF(SUBSTRING(se.pinfl, 1, 1) IN ('2','4','6','8'), 2, NULL))) = :gender)
                    AND (:age_from IS NULL OR
                        TIMESTAMPDIFF(YEAR,
                            STR_TO_DATE(CONCAT(
                                CASE WHEN SUBSTRING(se.pinfl, 1, 1) IN ('1','2') THEN '18'
                                     WHEN SUBSTRING(se.pinfl, 1, 1) IN ('3','4') THEN '19'
                                     ELSE '20' END,
                                SUBSTRING(se.pinfl, 6, 2), '-', SUBSTRING(se.pinfl, 4, 2), '-', SUBSTRING(se.pinfl, 2, 2)
                            ), '%Y-%m-%d'), CURDATE()
                        ) BETWEEN :age_from AND :age_to)
                    AND (:region IS NULL OR CASE
                        WHEN COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%–¢–û–®–ö–ï–ù–¢ –®–ê“≤–†–ò%' OR COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%Toshkent shahri%' THEN 'Toshkent shahri'
                        WHEN COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%–¢–û–®–ö–ï–ù–¢%' OR COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%Toshkent viloyati%' THEN 'Toshkent viloyati'
                        WHEN COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%–ê–ù–î–ò–ñ–û–ù%' OR COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%Andijon%' THEN 'Andijon'
                        WHEN COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%–ë–£–•–û–†–û%' OR COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%Buxoro%' THEN 'Buxoro'
                        WHEN COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%–§–ê–†“í–û–ù–ê%' OR COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%Farg%' THEN 'Farg''ona'
                        WHEN COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%–ñ–ò–ó–ó–ê–•%' OR COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%Jizzax%' THEN 'Jizzax'
                        WHEN COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%–ù–ê–ú–ê–ù–ì–ê–ù%' OR COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%Namangan%' THEN 'Namangan'
                        WHEN COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%–ù–ê–í–û–ò–ô%' OR COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%Navoiy%' THEN 'Navoiy'
                        WHEN COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%“ö–ê–®“ö–ê–î–ê–†–Å%' OR COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%Qashqadaryo%' THEN 'Qashqadaryo'
                        WHEN COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%“ö–û–†–ê“ö–ê–õ–ü–û“í%' OR COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%Qoraqalpog%' THEN 'Qoraqalpog''iston'
                        WHEN COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%–°–ê–ú–ê–†“ö–ê–ù–î%' OR COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%Samarqand%' THEN 'Samarqand'
                        WHEN COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%–°–ò–†–î–ê–†–Å%' OR COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%Sirdaryo%' THEN 'Sirdaryo'
                        WHEN COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%–°–£–†–•–û–ù–î–ê–†–Å%' OR COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%Surxondaryo%' THEN 'Surxondaryo'
                        WHEN COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%–•–û–†–ê–ó–ú%' OR COALESCE(a.region,a1.region,a2.region,a3.region) LIKE '%Xorazm%' THEN 'Xorazm'
                        ELSE COALESCE(a.region,a1.region,a2.region,a3.region)
                    END = :region)
                   AND (
                        :source IS NULL
                            OR :source = 'self_employed'
                            OR (:source = 'it_study' AND EXISTS (
                            SELECT 1 FROM it_study_student iss2 WHERE iss2.pnfl = se.pinfl
                        ))
                    )
                    AND (:employed_date_from IS NULL OR se.registrationDate BETWEEN :employed_date_from AND :employed_date_to)
                    AND (:exp_type IS NULL OR :exp_type = 'self_employed')) t

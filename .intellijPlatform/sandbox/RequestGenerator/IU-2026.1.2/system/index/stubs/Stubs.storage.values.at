                                WHEN iss.region LIKE '%irdaryo%'          THEN 'Sirdaryo'
                                WHEN iss.region LIKE '%urxondaryo%'       THEN 'Surxondaryo'
                                WHEN iss.region LIKE '%oshkent sh%'       THEN 'Toshkent shahri'
                                WHEN iss.region LIKE '%oshkent%'          THEN 'Toshkent viloyati'
                                WHEN iss.region LIKE '%orazm%'            THEN 'Xorazm'
                                ELSE COALESCE(iss.region, 'Noma''lum')
                                END AS region_name
                     FROM self_employeds se
                              JOIN it_study_student iss
                                   ON iss.id = se.source_id AND se.source_type = 'it_study'
                 ) normalized
            GROUP BY region_name
            ORDER BY total_students DESC
            """ˇ¸"""
            SELECT region_name,
                   COUNT(DISTINCT id) AS total_students,
                   0                  AS total_studying,
                   0                  AS total_graduated
            FROM (
                     SELECT se.id,
                            CASE
                                WHEN p.region LIKE '%–ê–ù–î–ò–ñ–û–ù%'       THEN 'Andijon'
                                WHEN p.region LIKE '%–ë–£–•–û–†–û%'        THEN 'Buxoro'
                                WHEN p.region LIKE '%–§–ê–†“í–û–ù–ê%'       THEN 'Farg''ona'
                                WHEN p.region LIKE '%–ñ–ò–ó–ó–ê–•%'        THEN 'Jizzax'
                                WHEN p.region LIKE '%–ù–ê–ú–ê–ù–ì–ê–ù%'      THEN 'Namangan'
                                WHEN p.region LIKE '%–ù–ê–í–û–ò–ô%'        THEN 'Navoiy'
                                WHEN p.region LIKE '%“ö–ê–®“ö–ê–î–ê–†–Å%'     THEN 'Qashqadaryo'
                                WHEN p.region LIKE '%“ö–û–†–ê“ö–ê–õ–ü–û“í%'    THEN 'Qoraqalpog''iston'
                                WHEN p.region LIKE '%–°–ê–ú–ê–†“ö–ê–ù–î%'     THEN 'Samarqand'
                                WHEN p.region LIKE '%–°–ò–†–î–ê–†–Å%'       THEN 'Sirdaryo'
                                WHEN p.region LIKE '%–°–£–†–•–û–ù–î–ê–†–Å%'    THEN 'Surxondaryo'
                                WHEN p.region LIKE '%–¢–û–®–ö–ï–ù–¢ –®–ê“≤–†–ò%' THEN 'Toshkent shahri'
                                WHEN p.region LIKE '%–¢–û–®–ö–ï–ù–¢%'       THEN 'Toshkent viloyati'
                                WHEN p.region LIKE '%–•–û–†–ê–ó–ú%'        THEN 'Xorazm'
                                ELSE COALESCE(p.region, 'Noma''lum')
                                END AS region_name
                     FROM self_employeds se
                              LEFT JOIN (
                         SELECT s.id, 'student' AS type, a.region
                         FROM student s LEFT JOIN address a ON a.student_id = s.id
                         UNION ALL
                         SELECT c.id, 'coder', a.region
                         FROM uzbek_coders_user c LEFT JOIN address a ON a.coders_user_id = c.id
                         UNION ALL
                         SELECT u.id, 'ak_user', a.region
                         FROM alkharazmi_user u LEFT JOIN address a ON a.alkharazmi_user_id = u.id
                     ) p ON p.id = se.source_id AND p.type = se.source_type
                     WHERE se.source_type IN ('student', 'coder', 'ak_user')
            
                     UNION ALL
            
                     SELECT se.id,
                            CASE
                                WHEN iss.region LIKE '%Andijon%'          THEN 'Andijon'
                                WHEN iss.region LIKE '%Buxoro%'           THEN 'Buxoro'
                                WHEN iss.region LIKE '%arg%ona%'          THEN 'Farg''ona'
                                WHEN iss.region LIKE '%izzax%'            THEN 'Jizzax'
                                WHEN iss.region LIKE '%amangan%'          THEN 'Namangan'
                                WHEN iss.region LIKE '%avoiy%'            THEN 'Navoiy'
                                WHEN iss.region LIKE '%ashqadaryo%'       THEN 'Qashqadaryo'
                                WHEN iss.region LIKE '%oraqalp%'          THEN 'Qoraqalpog''iston'
                                WHEN iss.region LIKE '%amarqand%'         THEN 'Samarqand'
                                WHEN iss.region LIKE '%irdaryo%'          THEN 'Sirdaryo'
                                WHEN iss.region LIKE '%urxondaryo%'       THEN 'Surxondaryo'
                                WHEN iss.region LIKE '%oshkent sh%'       THEN 'Toshkent shahri'
                                WHEN iss.region LIKE '%oshkent%'          THEN 'Toshkent viloyati'
                                WHEN iss.region LIKE '%orazm%'            THEN 'Xorazm'
                                ELSE COALESCE(iss.region, 'Noma''lum')
                                END AS region_name
                     FROM self_employeds se
                              JOIN it_study_student iss
                                   ON iss.id = se.source_id AND se.source_type = 'it_study'
                 ) normalized
            GROUP BY region_name
            ORDER BY total_students DESC
            """!"␀ˇ˚@Query(value = """
            SELECT t.course AS position,
               COUNT(*) AS count
        FROM (SELECT COALESCE(NULLIF(dm.course, ''), 'Noma''lum') AS course,
                     COALESCE(dm.pnfl, CONCAT('id_', dm.id))      AS person_key
              FROM dashboard_mv dm
                       LEFT JOIN self_employeds se ON se.pinfl = dm.pnfl AND se.deleted IS FALSE
                       LEFT JOIN experience exp ON exp.pin = dm.pnfl AND exp.deleted IS FALSE
              WHERE dm.education_status_name = 'completed'
                  AND (dm.work_place IS NOT NULL)
                  AND se.id IS NOT NULL
                  AND course not like '%kurs%'
                  AND course not like '%Matematika%'
                  AND course not like '%Noma''lum%'
              GROUP BY COALESCE(NULLIF(dm.course, ''), 'Noma''lum'),
                       COALESCE(dm.pnfl, CONCAT('id_', dm.id))) t
        GROUP BY t.course
        ORDER BY count DESC
        LIMIT 10
            """, nativeQuery = true)ˇ◊"""
            SELECT t.course AS position,
               COUNT(*) AS count
        FROM (SELECT COALESCE(NULLIF(dm.course, ''), 'Noma''lum') AS course,
                     COALESCE(dm.pnfl, CONCAT('id_', dm.id))      AS person_key
              FROM dashboard_mv dm
                       LEFT JOIN self_employeds se ON se.pinfl = dm.pnfl AND se.deleted IS FALSE
                       LEFT JOIN experience exp ON exp.pin = dm.pnfl AND exp.deleted IS FALSE
              WHERE dm.education_status_name = 'completed'
                  AND (dm.work_place IS NOT NULL)
                  AND se.id IS NOT NULL
                  AND course not like '%kurs%'
                  AND course not like '%Matematika%'
                  AND course not like '%Noma''lum%'
              GROUP BY COALESCE(NULLIF(dm.course, ''), 'Noma''lum'),
                       COALESCE(dm.pnfl, CONCAT('id_', dm.id))) t
        GROUP BY t.course
        ORDER BY count DESC
        LIMIT 10
            """ˇ◊"""

               COUNT(*) AS count
        FROM (SELECT COALESCE(NULLIF(dm.course, ''), 'Noma''lum') AS course,
                     COALESCE(dm.pnfl, CONCAT('id_', dm.id))      AS person_key
              FROM dashboard_mv dm
                       LEFT JOIN self_employeds se ON se.pinfl = dm.pnfl AND se.deleted IS FALSE

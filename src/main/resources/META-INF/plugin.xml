<idea-plugin>
    <id>uz.umar.http-request-generator</id>
    <name>HTTP Request Generator</name>
    <version>2026.2.0</version>

    <!--
        code        : must start with P, capitals only, max 15 chars
        release-date: today YYYYMMDD
        release-version: 20261 → means major version 2026.1
        optional="true" → enables freemium (.http is free, rest is Pro)

        ⚠ vendor must exactly match your organization_id on plugins.jetbrains.com
    -->
    <product-descriptor code="PHTTPREQUESTGEN"
                        release-date="20260521"
                        release-version="20262"
                        optional="true"/>

    <vendor email="umarraxmanberdiyev@gmail.com">Umar</vendor>

    <description>
        Generates .http, .env, cURL, Postman, TypeScript Axios, JS fetch, OpenAPI,
        Java Spring RestClient and Python requests files from Spring @RestController
        classes (Java and Kotlin) — directly from the editor context menu.

        Understands @PathVariable / @RequestParam / @RequestHeader / @RequestBody,
        @RequestPart multipart uploads, @SecurityRequirement (bearer/basic auth),
        optional params, and unwraps ResponseEntity/Optional/Flux/Page/List response types.
        Base URL is read from application.yml / application.properties.

        Free: .http (JetBrains HTTP Client) · .env · "Generate for all controllers"
        Pro ($0.99): cURL · Postman · TypeScript Axios · JS fetch · OpenAPI YAML ·
        Java RestClient · Python requests
    </description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>org.jetbrains.kotlin</depends>

    <!-- We only read Kotlin PSI via UAST light classes (no Kotlin analysis API),
         so the plugin is compatible with both K1 and K2 modes. -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true"/>
    </extensions>

    <actions>
        <group id="uz.umar.GenerateHttpGroup"
               class="uz.umar.GenerateHttpActionGroup"
               text="Generate HTTP Template"
               popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <action id="uz.umar.GenerateHttpFile"
                    class="uz.umar.GenerateHttpFileAction"
                    text=".http  (JetBrains HTTP Client)"/>
            <action id="uz.umar.GenerateEnv"
                    class="uz.umar.GenerateEnvAction"
                    text=".env  (base URL + token)"/>
            <action id="uz.umar.GenerateCurl"
                    class="uz.umar.GenerateCurlAction"
                    text="cURL  (.sh)  [Pro]"/>
            <action id="uz.umar.GeneratePostman"
                    class="uz.umar.GeneratePostmanAction"
                    text="Postman Collection  (.json)  [Pro]"/>
            <action id="uz.umar.GenerateTypeScriptAxios"
                    class="uz.umar.GenerateTypeScriptAxiosAction"
                    text="TypeScript  Axios  (.ts)  [Pro]"/>
            <action id="uz.umar.GenerateJsFetch"
                    class="uz.umar.GenerateJsFetchAction"
                    text="JavaScript  fetch  (.js)  [Pro]"/>
            <action id="uz.umar.GenerateOpenApi"
                    class="uz.umar.GenerateOpenApiAction"
                    text="OpenAPI  YAML  (.yaml)  [Pro]"/>
            <action id="uz.umar.GenerateRestClient"
                    class="uz.umar.GenerateRestClientAction"
                    text="Java  Spring RestClient  (.java)  [Pro]"/>
            <action id="uz.umar.GeneratePython"
                    class="uz.umar.GeneratePythonAction"
                    text="Python  requests  (.py)  [Pro]"/>
        </group>

        <action id="uz.umar.GenerateAllHttp"
                class="uz.umar.GenerateAllHttpAction"
                text="Generate .http for All Controllers">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>

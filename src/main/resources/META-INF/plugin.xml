<idea-plugin>
    <id>uz.umar.http-request-generator</id>
    <name>HTTP Request Generator</name>
    <version>2026.2.0</version>

    <!--
        code        : must start with P, capitals only, max 15 chars
        release-date: today YYYYMMDD
        release-version: 20261 → means major version 2026.1
        optional="true" → enables freemium (.http is free, rest is Pro)

        ⚠ vendor must exactly match your organization_id on plugins.jetbrains.com
    -->
    <product-descriptor code="PHTTPREQUESTGEN"
                        release-date="20260521"
                        release-version="20262"
                        optional="true"/>

    <vendor email="umarraxmanberdiyev@gmail.com">Umar</vendor>

    <description>
        Generates .http, cURL, Postman, TypeScript Axios, JS fetch and OpenAPI files
        from Spring @RestController classes — directly from the editor context menu.

        Free: .http (JetBrains HTTP Client)
        Pro ($0.99): cURL · Postman · TypeScript Axios · JS fetch · OpenAPI YAML
    </description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <actions>
        <group id="uz.umar.GenerateHttpGroup"
               class="uz.umar.GenerateHttpActionGroup"
               text="Generate HTTP Template"
               popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <action id="uz.umar.GenerateHttpFile"
                    class="uz.umar.GenerateHttpFileAction"
                    text=".http  (JetBrains HTTP Client)"/>
            <action id="uz.umar.GenerateCurl"
                    class="uz.umar.GenerateCurlAction"
                    text="cURL  (.sh)  [Pro]"/>
            <action id="uz.umar.GeneratePostman"
                    class="uz.umar.GeneratePostmanAction"
                    text="Postman Collection  (.json)  [Pro]"/>
            <action id="uz.umar.GenerateTypeScriptAxios"
                    class="uz.umar.GenerateTypeScriptAxiosAction"
                    text="TypeScript  Axios  (.ts)  [Pro]"/>
            <action id="uz.umar.GenerateJsFetch"
                    class="uz.umar.GenerateJsFetchAction"
                    text="JavaScript  fetch  (.js)  [Pro]"/>
            <action id="uz.umar.GenerateOpenApi"
                    class="uz.umar.GenerateOpenApiAction"
                    text="OpenAPI  YAML  (.yaml)  [Pro]"/>
        </group>
    </actions>
</idea-plugin>
